# General Gluetun Settings
VPN_SERVICE_PROVIDER={{ vpn_service_provider }}
VPN_TYPE={{ vpn_client_type }}
# The HTTP proxy is independent of Gluetun's built-in health check.
HTTPPROXY=on
HTTPPROXY_PORT=8888
# Shadowsocks is optional, disable if not used
SHADOWSOCKS=off

{% if vpn_client_type == 'wireguard' %}
WIREGUARD_PRIVATE_KEY={{ vars['vpn_' ~ vpn_service_provider ~ '_wireguard_privatekey'] }}
{% else %}
OPENVPN_USER={{ vars['vpn_' ~ vpn_service_provider ~ '_openvpn_user'] }}
OPENVPN_PASSWORD={{ vars['vpn_' ~ vpn_service_provider ~ '_openvpn_password'] }}
OPENVPN_PROTOCOL={{ vpn_openvpn_protocol }}
{% endif %}

# Provider-side inbound port forwarding is deliberately disabled.
VPN_PORT_FORWARDING=off
{% if vpn_server_countries | length > 0 %}
SERVER_COUNTRIES={{ vpn_server_countries | join(',') }}
{% endif %}
{% if vpn_server_hostnames | length > 0 %}
SERVER_HOSTNAMES={{ vpn_server_hostnames | join(',') }}
{% endif %}
