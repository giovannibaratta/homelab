apiVersion: admissionregistration.k8s.io/v1beta1
kind: MutatingAdmissionPolicy
metadata:
  name: registry-auth
spec:
  failurePolicy: Fail
  reinvocationPolicy: IfNeeded
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["pods"]
  matchConditions:
    - name: registry-image
      expression: >-
        (object.spec.containers + (has(object.spec.initContainers) ? object.spec.initContainers : []))
        .exists(c, ({{ k8s_registry_credentials.keys() | list | sort | to_json }}).exists(r, c.image.startsWith(r + "/")))
  mutations:
    - patchType: JSONPatch
      jsonPatch:
        expression: >-
          has(object.spec.imagePullSecrets)
          ? (object.spec.imagePullSecrets.exists(s, s.name == "registry-pull")
            ? []
            : [JSONPatch{op: "add", path: "/spec/imagePullSecrets/-",
              value: {"name": "registry-pull"}}])
          : [JSONPatch{op: "add", path: "/spec/imagePullSecrets",
              value: [{"name": "registry-pull"}]}]
---
apiVersion: admissionregistration.k8s.io/v1beta1
kind: MutatingAdmissionPolicyBinding
metadata:
  name: registry-auth
spec:
  policyName: registry-auth
  matchResources:
    namespaceSelector:
      # Clear the previous binding's namespace allowlist on upgrade.
      matchExpressions: []
