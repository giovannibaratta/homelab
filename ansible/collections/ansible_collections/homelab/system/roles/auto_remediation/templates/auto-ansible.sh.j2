#!/usr/bin/env bash
set -euo pipefail

# Interactive account whose presence delays scheduled execution.
TARGET_USER="ansible"
# Required continuous absence window, in seconds.
USER_DETECTION_WINDOW_IN_SECONDS=10
# Seconds between session checks within the absence window.
USER_DETECTION_INTERVAL_IN_SECONDS=1
# Seconds to wait before retrying after detecting an interactive session.
DETECTED_USER_SLEEP_IN_SECONDS=300
# Maximum total logout-wait time, in seconds; execution proceeds after this.
MAX_SLEEP_TIME_IN_SECONDS=$((2 * 60 * 60)) # 2 hours

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $@"
}


# Checks if the target user is connected within a given duration.
# Returns:
#   0 if the user IS FOUND during the check period.
#   1 if the user IS NOT FOUND
detect_user() {
    # Positional inputs: account name, observation window, and polling interval.
    # Both durations and the loop's elapsed observation time are in seconds.
    local target_user="$1"
    local check_duration="$2"
    local check_interval="$3"
    local i

    log "Performing initial check for '$target_user' for $check_duration seconds (interval: $check_interval second)..."
    for (( i=0; i < check_duration; i+=check_interval )); do
        # -w: match whole word
        if who | grep -qw "$target_user"; then
            log "User '$target_user' detected"
            return 0
        fi

        sleep "$check_interval"
    done

    log "User '$target_user' not detected"
    return 1
}

wait_for_user_logout() {
    # Account to monitor; timestamps are Unix seconds, elapsed_time is a duration.
    local target_user="$1"

    log "Starting wait loop for user '$target_user' absence (max ${MAX_SLEEP_TIME_IN_SECONDS}s)."
    local start_time
    local current_time
    local elapsed_time
    start_time=$(date +%s)

    while true; do # Loop controlled by time check below
        current_time=$(date +%s)
        elapsed_time=$((current_time - start_time))

        if (( elapsed_time >= MAX_SLEEP_TIME_IN_SECONDS )); then
            log "Maximum wait time (${MAX_SLEEP_TIME_IN_SECONDS}s) reached. Proceeding anyway..."
            return 0
        fi

        if detect_user "$target_user" "$USER_DETECTION_WINDOW_IN_SECONDS" "$USER_DETECTION_INTERVAL_IN_SECONDS"; then
          log "User '$target_user' was detected by detect_user. Sleeping for $DETECTED_USER_SLEEP_IN_SECONDS seconds."
          log "Current elapsed time: ${elapsed_time}s / ${MAX_SLEEP_TIME_IN_SECONDS}s."
          sleep "$DETECTED_USER_SLEEP_IN_SECONDS"
        else
          log "User '$target_user' confirmed absent by detect_user. Proceeding..."
          return 0 # Success, proceed with execution
        fi
    done

    # This part should technically not be reached
    exit 1
}

check_for_running_playbook() {
    log "Checking for existing ansible-playbook processes..."
    # pgrep -f checks the full command line for the pattern.
    if pgrep -f "ansible-playbook" >/dev/null; then
        log "Error: Another ansible-playbook process is already running. Exiting."
        log "Running processes found:"
        # pgrep -a shows the full command line.
        pgrep -af "ansible-playbook" | while read -r line; do log "  $line"; done
        exit 1
    fi
    log "No other ansible-playbook process found. Continuing."
}


require_option_value() {
    # Inputs: option name and its candidate value (empty when absent).
    local option="$1"
    local value="${2-}"
    if [[ -z "$value" || "$value" == -* ]]; then
        log "Error: $option requires a value."
        exit 2
    fi
}

# --debug marker: permits tag/branch overrides and bypasses session detection.
# Skips metric export; verbosity and no_log handling are unchanged.
DEBUG=false
# --tags selection forwarded as one argument; empty means the full playbook.
ANSIBLE_TAGS=""
# Debug branch cloned from origin; empty defaults to main.
GIT_BRANCH=""
# Enabled by --debug or the independent --skip-user-logout-check flag.
SKIP_USER_LOGOUT_CHECK=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --debug)
            DEBUG=true
            shift
            ;;
        --tags)
            require_option_value "$1" "${2-}"
            ANSIBLE_TAGS="$2"
            shift 2
            ;;
        --branch)
            require_option_value "$1" "${2-}"
            GIT_BRANCH="$2"
            shift 2
            ;;
        --skip-user-logout-check)
            SKIP_USER_LOGOUT_CHECK=true
            shift
            ;;
        *)
            log "Error: Unknown argument: $1"
            exit 2
            ;;
    esac
done

if [[ "$DEBUG" != true && ( -n "$ANSIBLE_TAGS" || -n "$GIT_BRANCH" ) ]]; then
    log "Error: --tags and --branch require --debug."
    exit 2
fi

if [[ -n "$GIT_BRANCH" ]] && ! git check-ref-format --branch "$GIT_BRANCH" >/dev/null 2>&1; then
    log "Error: Invalid branch name."
    exit 2
fi

if [[ "$DEBUG" == true ]]; then
    SKIP_USER_LOGOUT_CHECK=true
    log "Debug mode: skipping user login/logout detection."
fi

if [ "$SKIP_USER_LOGOUT_CHECK" = false ]; then
    wait_for_user_logout "$TARGET_USER"
fi

check_for_running_playbook

# Installed runner directory containing repo/, python-env/, and config/.
ROOT_DIR="/app/auto-ansible"

source "${ROOT_DIR}/python-env/bin/activate"

# Playbook source; debug mode replaces this with an isolated temporary clone.
RUN_REPO_DIR="${ROOT_DIR}/repo"
# Allocated only in debug mode; the EXIT trap removes it on success or failure.
DEBUG_DIR=""

cleanup_debug_checkout() {
    # Preserve the failing command/Ansible status even if cleanup fails.
    local exit_code=$?
    trap - EXIT
    if [[ -n "$DEBUG_DIR" ]]; then
        rm -rf -- "$DEBUG_DIR" || log "Could not remove debug checkout: ${DEBUG_DIR}"
    fi
    exit "$exit_code"
}

if [[ "$DEBUG" == true ]]; then
    # Read origin without fetching, switching, or modifying the scheduled repo.
    # Remote URL used only for the fresh clone, never printed by the script.
    REPO_URL=$(git -C "$RUN_REPO_DIR" remote get-url origin)
    DEBUG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/auto-ansible-debug.XXXXXXXX")
    trap cleanup_debug_checkout EXIT
    GIT_BRANCH="${GIT_BRANCH:-main}"
    RUN_REPO_DIR="${DEBUG_DIR}/repo"
    log "Cloning debug branch ${GIT_BRANCH} into ${RUN_REPO_DIR}"
    git clone --depth 1 --single-branch --branch "$GIT_BRANCH" -- "$REPO_URL" "$RUN_REPO_DIR"
    git -C "$RUN_REPO_DIR" checkout --detach HEAD
else
    # Refuse local changes, a different branch, or local-only/divergent commits.
    # Porcelain status includes staged, unstaged, and untracked files.
    CHECKOUT_STATUS=$(git -C "$RUN_REPO_DIR" status --porcelain)
    if [[ -n "$CHECKOUT_STATUS" ]]; then
        log "Error: Scheduled checkout has local changes; leaving it untouched."
        exit 1
    fi
    # Empty for detached HEAD, which is also rejected for scheduled runs.
    CURRENT_BRANCH=$(git -C "$RUN_REPO_DIR" branch --show-current)
    if [[ "$CURRENT_BRANCH" != main ]]; then
        log "Error: Scheduled checkout must be on main."
        exit 1
    fi
    log "Fetching main for the scheduled checkout"
    git -C "$RUN_REPO_DIR" fetch origin refs/heads/main:refs/remotes/origin/main
    if ! git -C "$RUN_REPO_DIR" merge-base --is-ancestor HEAD refs/remotes/origin/main; then
        log "Error: Scheduled checkout has local-only commits or diverges from origin/main."
        exit 1
    fi
    git -C "$RUN_REPO_DIR" merge --ff-only refs/remotes/origin/main
fi

# Private Bitwarden token; passed only via the playbook process environment.
BWS_TOKEN=$(cat "${ROOT_DIR}/config/bws_access_token")

# Bash array preserves argument boundaries, including comma-separated tag lists.
# inventory_hostname is rendered by Ansible when installing this script.
ANSIBLE_ARGS=(--connection=local --limit "{{ inventory_hostname }}" "${RUN_REPO_DIR}/ansible/setup_homelab.yaml" -i "${RUN_REPO_DIR}/ansible/inventory/home.yaml" -v)

if [[ -n "$ANSIBLE_TAGS" ]]; then
    ANSIBLE_ARGS+=(--tags "$ANSIBLE_TAGS")
fi

log "Running ansible playbook"
# Resolve ansible.cfg, fact cache and project collections from this checkout.
cd "${RUN_REPO_DIR}/ansible"
# A playbook failure must still reach the metrics export under errexit.
# EXIT_CODE retains Ansible's process status and becomes this script's exit code.
if BWS_ACCESS_TOKEN="${BWS_TOKEN}" ansible-playbook "${ANSIBLE_ARGS[@]}"; then
    EXIT_CODE=0
else
    EXIT_CODE=$?
fi

if [[ "$DEBUG" == true ]]; then
    log "Debug run finished with exit code ${EXIT_CODE}; skipping metrics export."
    exit "$EXIT_CODE"
fi

# Prometheus metrics export
# node_exporter's textfile collector directory and the persisted runner metrics.
METRICS_DIR="/var/lib/node_exporter/textfile_collector"
METRICS_FILE="${METRICS_DIR}/auto_ansible.prom"

log "Exporting metrics to ${METRICS_FILE}"
mkdir -p "${METRICS_DIR}"

# Persistent counts, including the current run after the increments below.
# RUNS counts completed playbook invocations; FAILURES counts unsuccessful ones.
# CONSECUTIVE_FAILURES resets on success; "missing" marks an older metrics file.
RUNS=0
FAILURES=0
CONSECUTIVE_FAILURES=0
if [ -f "$METRICS_FILE" ]; then
    RUNS=$(grep "^auto_ansible_runs_total " "$METRICS_FILE" | cut -d' ' -f2 || echo 0)
    FAILURES=$(grep "^auto_ansible_failures_total " "$METRICS_FILE" | cut -d' ' -f2 || echo 0)

    CONSECUTIVE_FAILURES=$(awk '$1 == "auto_ansible_consecutive_failures" { print $2; found=1; exit } END { if (!found) print "missing" }' "$METRICS_FILE")
    if [ "$CONSECUTIVE_FAILURES" = "missing" ]; then
        # Seed the new streak metric from the last known run during migration.
        # Previous exported status: 1=success, 0=failure, empty=unknown.
        PREVIOUS_STATUS=$(awk '$1 == "auto_ansible_last_run_status" { print $2; found=1; exit } END { if (!found) print "" }' "$METRICS_FILE")
        if [ "$PREVIOUS_STATUS" = "0" ]; then
            CONSECUTIVE_FAILURES=1
        else
            CONSECUTIVE_FAILURES=0
        fi
    fi
fi

RUNS=$((RUNS + 1))
# Prometheus success gauge (1=success, 0=failure), unlike the process EXIT_CODE.
STATUS=1
if [ $EXIT_CODE -ne 0 ]; then
    FAILURES=$((FAILURES + 1))
    CONSECUTIVE_FAILURES=$((CONSECUTIVE_FAILURES + 1))
    STATUS=0
    log "Ansible playbook failed with exit code ${EXIT_CODE}"
else
    CONSECUTIVE_FAILURES=0
    log "Ansible playbook completed successfully"
fi

# Staging path in the same directory; renamed atomically to METRICS_FILE so
# node_exporter never reads a partially written metrics snapshot.
TEMP_METRICS_FILE="${METRICS_FILE}.tmp"
cat <<EOF > "${TEMP_METRICS_FILE}"
# HELP auto_ansible_last_run_timestamp_seconds Timestamp of the last auto-ansible run.
# TYPE auto_ansible_last_run_timestamp_seconds gauge
auto_ansible_last_run_timestamp_seconds $(date +%s)
# HELP auto_ansible_last_run_status Status of the last auto-ansible run (1=success, 0=failure).
# TYPE auto_ansible_last_run_status gauge
auto_ansible_last_run_status $STATUS
# HELP auto_ansible_runs_total Total number of auto-ansible runs.
# TYPE auto_ansible_runs_total counter
auto_ansible_runs_total $RUNS
# HELP auto_ansible_failures_total Total number of auto-ansible failures.
# TYPE auto_ansible_failures_total counter
auto_ansible_failures_total $FAILURES
# HELP auto_ansible_consecutive_failures Number of consecutive failed Auto-Ansible runs.
# TYPE auto_ansible_consecutive_failures gauge
auto_ansible_consecutive_failures $CONSECUTIVE_FAILURES
EOF

mv "${TEMP_METRICS_FILE}" "${METRICS_FILE}"

exit $EXIT_CODE
