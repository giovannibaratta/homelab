apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ k8s_monitoring_discovery_account_name }}
  namespace: {{ k8s_monitoring_discovery_namespace }}
automountServiceAccountToken: false
---
# Explicitly provision a stable credential for the external scraper. It can only
# list pod metadata in the namespaces below; it cannot read Secrets or proxy APIs.
apiVersion: v1
kind: Secret
metadata:
  name: {{ k8s_monitoring_discovery_secret_name }}
  namespace: {{ k8s_monitoring_discovery_namespace }}
  annotations:
    kubernetes.io/service-account.name: {{ k8s_monitoring_discovery_account_name }}
type: kubernetes.io/service-account-token
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ k8s_monitoring_discovery_account_name }}
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, watch]
{% for namespace in k8s_monitoring_discovery_namespaces %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  labels:
    app.kubernetes.io/part-of: homelab-monitoring
    app.kubernetes.io/component: prometheus-discovery
  name: {{ k8s_monitoring_discovery_account_name }}
  namespace: {{ namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ k8s_monitoring_discovery_account_name }}
subjects:
  - kind: ServiceAccount
    name: {{ k8s_monitoring_discovery_account_name }}
    namespace: {{ k8s_monitoring_discovery_namespace }}
{% endfor %}
