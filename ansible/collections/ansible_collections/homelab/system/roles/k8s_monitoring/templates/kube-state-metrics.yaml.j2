{% set collectors %}{% include 'cnpg-collectors.yaml.j2' %}{% endset %}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: homelab-kube-state-metrics
  namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: homelab-kube-state-metrics
rules:
  - apiGroups: [""]
    resources: [pods, nodes, namespaces, persistentvolumeclaims, persistentvolumes]
    verbs: [list, watch]
  - apiGroups: [apps]
    resources: [deployments, daemonsets, statefulsets, replicasets]
    verbs: [list, watch]
  - apiGroups: [batch]
    resources: [jobs, cronjobs]
    verbs: [list, watch]
  - apiGroups: [apiextensions.k8s.io]
    resources: [customresourcedefinitions]
    verbs: [list, watch]
  - apiGroups: [postgresql.cnpg.io]
    resources: [clusters]
    verbs: [list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: homelab-kube-state-metrics
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: homelab-kube-state-metrics
subjects:
  - kind: ServiceAccount
    name: homelab-kube-state-metrics
    namespace: kube-system
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homelab-kube-state-metrics
  namespace: kube-system
data:
  custom-resources.yaml: |
{{ collectors | indent(4, true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homelab-kube-state-metrics
  namespace: kube-system
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: homelab-kube-state-metrics
  template:
    metadata:
      labels:
        app.kubernetes.io/name: homelab-kube-state-metrics
      annotations:
        # Restart when collector definitions change.
        monitoring.homelab/collector-revision: "{{ collectors | hash('sha256') }}"
    spec:
      serviceAccountName: homelab-kube-state-metrics
      nodeSelector:
        kubernetes.io/os: linux
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: kube-state-metrics
          image: registry.k8s.io/kube-state-metrics/kube-state-metrics:v{{ kube_state_metrics_version }}
          args:
            - --resources=pods,nodes,namespaces,persistentvolumeclaims,persistentvolumes,deployments,daemonsets,statefulsets,replicasets,jobs,cronjobs
            - --custom-resource-state-config-file=/etc/kube-state-metrics/custom-resources.yaml
          ports:
            - {name: http-metrics, containerPort: 8080}
            - {name: telemetry, containerPort: 8081}
          readinessProbe:
            httpGet: {path: /readyz, port: telemetry}
          livenessProbe:
            httpGet: {path: /livez, port: http-metrics}
            initialDelaySeconds: 10
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {memory: 384Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          volumeMounts:
            - {name: collectors, mountPath: /etc/kube-state-metrics, readOnly: true}
      volumes:
        - name: collectors
          configMap:
            name: homelab-kube-state-metrics
---
apiVersion: v1
kind: Service
metadata:
  name: homelab-kube-state-metrics
  namespace: kube-system
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: homelab-kube-state-metrics
  ports:
    - {name: http-metrics, port: 8080, targetPort: http-metrics}

