[Unit]
Description=Persistent Loopback device for Linstor Datastore
# The backing file may live on a separate filesystem (for example /app).
# Keep normal boot/shutdown dependencies and wait for that filesystem.
RequiresMountsFor={{ linstor_backing_file_path | dirname }}
After=systemd-udev-trigger.service systemd-modules-load.service
# LVM monitoring precedes local mounts; ordering before it creates a cycle.
Before=kubelet.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'if ! /sbin/losetup -j {{ linstor_backing_file_path }} | grep -q .; then /sbin/losetup -f {{ linstor_backing_file_path }}; fi'
ExecStop=/bin/sh -c 'DEV=$(/sbin/losetup -j {{ linstor_backing_file_path }} | cut -d: -f1); [ -n "$DEV" ] && /sbin/losetup -d "$DEV"'

[Install]
WantedBy=multi-user.target
