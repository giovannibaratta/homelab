global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    scrape_interval: 15s
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'hosts'
    scrape_interval: 10s
    static_configs:
      # Node exporter
{% for host in prometheus_targets %}
      - targets: ['{{ hostvars[host].internal_ip }}:9100']
        labels:
          instance: '{{ hostvars[host].internal_ip }}'
          # Lookup the reboot preference from the inventory hostvars
          reboot_enabled: "{{ 'false' if hostvars[host]['system_update_day'] | default('') == 'never' else 'true' }}"
{% endfor %}

      # Process exporter
{% for host in prometheus_targets %}
      - targets: ['{{ hostvars[host].internal_ip }}:9101']
        labels:
          instance: '{{ hostvars[host].internal_ip }}'
{% endfor %}

    metric_relabel_configs:
      # Different host models report CPU temperature metrics differently.
      # We remap them to a common metric name for alerting purposes.
      - source_labels: [__name__, chip, sensor]
        # Match the specific metric name AND the specific label values
        regex: 'node_hwmon_temp_celsius;pci0000:00_0000:00:18_3;temp1'
        # The target label is __name__, which holds the metric name itself
        target_label: __name__
        # The new abstract name you want to use
        replacement: 'remapped_node_cpu_temp_celsius'
      - source_labels: [__name__, chip, sensor]
        # Match the specific metric name AND the specific label values
        regex: 'node_hwmon_temp_celsius;platform_coretemp_0;temp1'
        # The target label is __name__, which holds the metric name itself
        target_label: __name__
        # The new abstract name you want to use
        replacement: 'remapped_node_cpu_temp_celsius'

  - job_name: 'pingexporter'
    scrape_interval: 1s
    scheme: https
    static_configs:
      - targets: ['pingexporter.{{ internal_domain }}']

  - job_name: 'idp'
    scrape_interval: 5s
    scheme: https
    metrics_path: "/debug/metrics"
    static_configs:
      - targets: ['idp.{{ internal_domain }}']

{% set crowdsec_targets = namespace(hosts=[]) %}
{% for host in groups['all'] %}
{% if hostvars[host].deploy_crowdsec | default(false) | bool %}
{% set crowdsec_targets.hosts = crowdsec_targets.hosts + [host] %}
{% endif %}
{% endfor %}
  - job_name: 'crowdsec'
    scrape_interval: 15s
    static_configs:{{ ' []' if not crowdsec_targets.hosts else '' }}
{% for host in crowdsec_targets.hosts %}
      - targets: ['{{ hostvars[host].crowdsec_metrics_address | default(hostvars[host].internal_ip) }}:{{ hostvars[host].crowdsec_metrics_port | default(6060) }}']
        labels:
          instance: '{{ hostvars[host].internal_ip }}'
          host: '{{ host }}'
{% endfor %}

{% if deploy_sungrow_exporter | default(false) | bool %}
  - job_name: 'sungrow_exporter'
    scrape_interval: 30s
    scheme: https
    metrics_path: "/metrics"
    static_configs:
      - targets: ['sungrow-exporter.{{ internal_domain }}']
{% endif %}

rule_files:
  - /opt/prometheus/conf/rules/*.yaml

alerting:
  alertmanagers:
    - scheme: https
      static_configs:
        - targets: ['alertmanager.{{ internal_domain }}']
