# Cluster-wide pod discovery
#
# TODO: Move these exporter definitions into role inputs supplied by the calling
# playbook (selectors, ports, paths, parameters and relabeling). Job names are also
# used by alert rules and Grafana queries; coordinate any renaming with those users.

# Kubernetes object health. homelab.system.k8s_monitoring supplies this pod label
# and port 8080. Keep workload namespace/pod/node labels from the metrics intact.
- job_name: kube-state-metrics
  scrape_interval: 15s
  scrape_timeout: 10s
  kubernetes_sd_configs:
    - role: pod
      api_server: {{ prometheus_kubernetes_api_server | to_json }}
      authorization:
        credentials_file: /opt/prometheus/conf/kubernetes-token
      tls_config:
        ca_file: /opt/prometheus/conf/kubernetes-ca.crt
      selectors:
        - role: pod
          label: "app.kubernetes.io/name=homelab-kube-state-metrics"
  relabel_configs:
    - source_labels: [__meta_kubernetes_pod_container_port_number]
      regex: '8080'
      action: keep
    - source_labels: [__meta_kubernetes_pod_phase]
      regex: Pending|Running|Unknown
      action: keep

# Exporter telemetry from the same kube-state-metrics pod, on port 8081.
# List/watch errors here reveal failures to collect Kubernetes object state.
- job_name: kube-state-metrics-internal
  scrape_interval: 15s
  scrape_timeout: 10s
  kubernetes_sd_configs:
    - role: pod
      api_server: {{ prometheus_kubernetes_api_server | to_json }}
      authorization:
        credentials_file: /opt/prometheus/conf/kubernetes-token
      tls_config:
        ca_file: /opt/prometheus/conf/kubernetes-ca.crt
      selectors:
        - role: pod
          label: "app.kubernetes.io/name=homelab-kube-state-metrics"
  relabel_configs:
    - source_labels: [__meta_kubernetes_pod_container_port_number]
      regex: '8081'
      action: keep
    - source_labels: [__meta_kubernetes_pod_phase]
      regex: Pending|Running|Unknown
      action: keep

# CloudNativePG supplies the cnpg.io/cluster pod label and metrics port 9187.
# Attach each instance's namespace, pod, node and cluster identity to its metrics.
- job_name: cloudnativepg
  scrape_interval: 15s
  scrape_timeout: 10s
  kubernetes_sd_configs:
    - role: pod
      api_server: {{ prometheus_kubernetes_api_server | to_json }}
      authorization:
        credentials_file: /opt/prometheus/conf/kubernetes-token
      tls_config:
        ca_file: /opt/prometheus/conf/kubernetes-ca.crt
      selectors:
        - role: pod
          label: "cnpg.io/cluster"
  relabel_configs:
    - source_labels: [__meta_kubernetes_pod_container_port_number]
      regex: '9187'
      action: keep
    - source_labels: [__meta_kubernetes_pod_phase]
      regex: Pending|Running|Unknown
      action: keep
    - source_labels: [__meta_kubernetes_namespace]
      target_label: namespace
    - source_labels: [__meta_kubernetes_pod_name]
      target_label: pod
    - source_labels: [__meta_kubernetes_pod_node_name]
      target_label: node
    - source_labels: [__meta_kubernetes_pod_label_cnpg_io_cluster]
      target_label: cnpg_cluster

# Piraeus supplies the linstor-controller component label and API/metrics port
# 3370. Preserve the node labels inside LINSTOR metrics: they identify satellites,
# not the node hosting the controller pod.
- job_name: linstor
  scrape_interval: 15s
  scrape_timeout: 10s
  kubernetes_sd_configs:
    - role: pod
      api_server: {{ prometheus_kubernetes_api_server | to_json }}
      authorization:
        credentials_file: /opt/prometheus/conf/kubernetes-token
      tls_config:
        ca_file: /opt/prometheus/conf/kubernetes-ca.crt
      selectors:
        - role: pod
          label: "app.kubernetes.io/component=linstor-controller"
  relabel_configs:
    - source_labels: [__meta_kubernetes_pod_container_port_number]
      regex: '3370'
      action: keep
    - source_labels: [__meta_kubernetes_pod_phase]
      regex: Pending|Running|Unknown
      action: keep
    - source_labels: [__meta_kubernetes_namespace]
      target_label: namespace

# Piraeus supplies the linstor-satellite component label and DRBD Reactor port
# 9942. The pod's node identifies the satellite for desired-state coverage checks.
- job_name: drbd
  scrape_interval: 15s
  scrape_timeout: 10s
  kubernetes_sd_configs:
    - role: pod
      api_server: {{ prometheus_kubernetes_api_server | to_json }}
      authorization:
        credentials_file: /opt/prometheus/conf/kubernetes-token
      tls_config:
        ca_file: /opt/prometheus/conf/kubernetes-ca.crt
      selectors:
        - role: pod
          label: "app.kubernetes.io/component=linstor-satellite"
  relabel_configs:
    - source_labels: [__meta_kubernetes_pod_container_port_number]
      regex: '9942'
      action: keep
    - source_labels: [__meta_kubernetes_pod_phase]
      regex: Pending|Running|Unknown
      action: keep
    - source_labels: [__meta_kubernetes_namespace]
      target_label: namespace
    - source_labels: [__meta_kubernetes_pod_name]
      target_label: pod
    - source_labels: [__meta_kubernetes_pod_node_name]
      target_label: node

# homelab.system.k8s_monitoring supplies this JSON exporter label, port 7979,
# the linstor-policy module and the monitoring.homelab/linstor-api-url annotation.
# /probe reads that annotated API URL to expose resource-group placement policy.
- job_name: linstor-policy
  scrape_interval: 15s
  scrape_timeout: 10s
  metrics_path: /probe
  params:
    module: [linstor-policy]
  kubernetes_sd_configs:
    - role: pod
      api_server: {{ prometheus_kubernetes_api_server | to_json }}
      authorization:
        credentials_file: /opt/prometheus/conf/kubernetes-token
      tls_config:
        ca_file: /opt/prometheus/conf/kubernetes-ca.crt
      selectors:
        - role: pod
          label: "app.kubernetes.io/name=homelab-linstor-policy-exporter"
  relabel_configs:
    - source_labels: [__meta_kubernetes_pod_container_port_number]
      regex: '7979'
      action: keep
    - source_labels: [__meta_kubernetes_pod_phase]
      regex: Pending|Running|Unknown
      action: keep
    - source_labels: [__meta_kubernetes_namespace]
      target_label: namespace
    - source_labels: [__meta_kubernetes_pod_annotation_monitoring_homelab_linstor_api_url]
      regex: '(.+)'
      action: keep
    - source_labels: [__meta_kubernetes_pod_annotation_monitoring_homelab_linstor_api_url]
      target_label: __param_target
