    {
      "id": 2,
      "title": "WAN throughput (all traffic)",
      "description": "All traffic on each PPPoE ftth interface: RX/download and TX/upload. Includes local and forwarded traffic, allowed and subsequently blocked packets. Interface counters exclude physical Ethernet/PPPoE overhead; reconnects reset counters.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "8 * rate(node_network_receive_bytes_total{device=\"ftth\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "__auto"
        },
        {
          "expr": "8 * rate(node_network_transmit_bytes_total{device=\"ftth\"}[$__rate_interval])",
          "refId": "B",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "WAN received bytes \u2014 selected range",
      "description": "Estimated received volume over the selected range. Includes dropped ingress packets; not application payload volume.",
