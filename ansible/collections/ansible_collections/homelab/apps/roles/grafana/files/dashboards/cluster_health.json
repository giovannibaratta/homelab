{
  "uid": "homelab-cluster-health",
  "title": "Homelab \u2014 Kubernetes, PostgreSQL and storage health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "homelab",
    "kubernetes",
    "postgresql",
    "linstor",
    "drbd"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus_ds"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "definition": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster",
        "label": "PostgreSQL cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus_ds"
        },
        "query": "label_values(cnpg_cluster_instances{namespace=~\"$namespace\"}, cnpg_cluster)",
        "definition": "label_values(cnpg_cluster_instances{namespace=~\"$namespace\"}, cnpg_cluster)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node",
        "label": "Storage node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus_ds"
        },
        "query": "label_values(up{job=\"drbd\"}, node)",
        "definition": "label_values(up{job=\"drbd\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "resource",
        "label": "DRBD resource",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus_ds"
        },
        "query": "label_values(drbd_peerdevice_outofsync_bytes{node=~\"$node\"}, name)",
        "definition": "label_values(drbd_peerdevice_outofsync_bytes{node=~\"$node\"}, name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Live overview \u2014 15 second refresh; alerts have a recovery grace period",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Exporter scrape health (1 = reachable)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"kube-state-metrics|kube-state-metrics-internal|cloudnativepg|linstor|linstor-policy|drbd\"}",
          "legendFormat": "{{namespace}} {{pod}} {{node}} {{name}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "Check this first. Missing data does not mean healthy.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "customresource_group": true,
              "customresource_kind": true,
              "customresource_version": true,
              "backup_destination": true
            }
          }
        }
      ]
    },
    {
