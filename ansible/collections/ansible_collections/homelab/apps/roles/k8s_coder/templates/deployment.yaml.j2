apiVersion: apps/v1
kind: Deployment
metadata:
  name: coder
  namespace: {{ k8s_coder_namespace }}
  labels:
    app.kubernetes.io/name: coder
    app.kubernetes.io/part-of: coder
spec:
  replicas: {{ k8s_coder_replicas }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: coder
  template:
    metadata:
      labels:
        app.kubernetes.io/name: coder
    spec:
      serviceAccountName: coder
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: coder
          image: ghcr.io/coder/coder:{{ coder_version }}
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 1000
            runAsGroup: 1000
            capabilities:
              drop:
                - ALL
          env:
            - name: CODER_HTTP_ADDRESS
              value: "0.0.0.0:{{ coder_service_port }}"
            - name: CODER_ACCESS_URL
              value: "https://{{ coder_external_domain }}"
            - name: CODER_PG_CONNECTION_URL
              valueFrom:
                secretKeyRef:
                  name: coder-credentials
                  key: connection-url
            - name: CODER_OIDC_ISSUER_URL
              value: "https://idp.{{ internal_domain }}"
            - name: CODER_OIDC_CLIENT_ID
              value: "{{ __coder_zitadel_client_id | default('') }}"
            - name: CODER_OIDC_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: coder-credentials
                  key: oidc-client-secret
            - name: CODER_OIDC_USER_ROLE_FIELD
              value: "groups"
            - name: CODER_OIDC_USER_ROLE_MAPPING
              value: '{"admin": ["owner"]}'
            - name: CODER_OIDC_ALLOW_SIGNUPS
              value: "true"
            - name: CODER_DISABLE_PASSWORD_AUTH
              value: "false"
            - name: CODER_PROMETHEUS_ENABLE
              value: "true"
            - name: CODER_PROMETHEUS_ADDRESS
              value: "0.0.0.0:2112"
          ports:
            - name: http
              containerPort: {{ coder_service_port }}
              protocol: TCP
            - name: metrics
              containerPort: 2112
              protocol: TCP
          livenessProbe:
            httpGet:
              path: /api/v2/buildinfo
              port: http
            initialDelaySeconds: 15
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 6
          readinessProbe:
            httpGet:
              path: /api/v2/buildinfo
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 2000m
              memory: 2Gi
---
apiVersion: v1
kind: Service
metadata:
  name: coder
  namespace: {{ k8s_coder_namespace }}
  labels:
    app.kubernetes.io/name: coder
spec:
  type: ClusterIP
  ports:
    - name: http
      port: {{ coder_service_port }}
      targetPort: http
      protocol: TCP
    - name: metrics
      port: 2112
      targetPort: metrics
      protocol: TCP
  selector:
    app.kubernetes.io/name: coder
