apiVersion: v1
kind: ServiceAccount
metadata:
  name: coder
  namespace: {{ k8s_coder_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: coder-workspace-provisioner
  namespace: {{ k8s_coder_workspaces_namespace }}
rules:
  - apiGroups: ["", "apps", "batch"]
    resources: ["pods", "pods/exec", "pods/log", "persistentvolumeclaims", "secrets", "configmaps", "services", "jobs"]
    verbs: ["*"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: coder-workspace-provisioner-binding
  namespace: {{ k8s_coder_workspaces_namespace }}
subjects:
  - kind: ServiceAccount
    name: coder
    namespace: {{ k8s_coder_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: coder-workspace-provisioner
