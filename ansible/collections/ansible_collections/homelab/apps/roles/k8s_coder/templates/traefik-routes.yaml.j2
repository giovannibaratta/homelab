---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: coder
  namespace: {{ k8s_coder_namespace }}
spec:
  entryPoints:
    - web
    - websecure
  routes:
    - match: Host(`{{ coder_external_domain }}`)
      kind: Rule
      services:
        - name: coder
          port: {{ coder_service_port }}
